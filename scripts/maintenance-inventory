#!/usr/bin/env python3
"""Generate/check the public version inventory from tracked non-secret sources."""
import argparse
from pathlib import Path
import re
import subprocess
import sys
import tomllib
import yaml


def walk(value):
    if isinstance(value, dict):
        yield value
        for item in value.values():
            yield from walk(item)
    elif isinstance(value, list):
        for item in value:
            yield from walk(item)


def collect(root):
    rows = set()
    sources = [root / value for value in subprocess.check_output(
        ['git', '-C', str(root), 'ls-files', '-z', '--cached'], text=True).split('\0') if value]
    def add(component, reference, pin, path):
        rows.add((component, str(reference), pin, str(path.relative_to(root))))
    for path in sorted(path for path in sources if path.suffix == '.yaml' and path.relative_to(root).parts[0] == 'kubernetes'):
        if 'secrets' in path.relative_to(root).parts or path.name.endswith('.sops.yaml'):
            continue
        for document in yaml.safe_load_all(path.read_text()):
            if not isinstance(document, dict) or document.get('kind') == 'Secret':
                continue
            for mapping in walk(document):
                image = mapping.get('image')
                if isinstance(image, str) and any(marker in image for marker in ('/', ':', '@')):
                    add('Container image', image, 'digest' if re.search(r'@sha256:[0-9a-f]{64}$', image) else 'tag only', path)
                if isinstance(mapping.get('images'), list):
                    for image in mapping['images']:
                        if isinstance(image, dict):
                            reference = image.get('newName', image['name'])
                            reference += ':' + str(image['newTag']) if 'newTag' in image else ''
                            reference += '@' + image['digest'] if 'digest' in image else ''
                            add('Container image', reference, 'digest' if re.search(r'@sha256:[0-9a-f]{64}$', reference) else 'tag only', path)
                if 'chart' in mapping and 'targetRevision' in mapping:
                    add('Helm chart: ' + mapping['chart'], mapping['targetRevision'], 'chart version', path)
                if isinstance(mapping.get('resources'), list):
                    for resource in mapping['resources']:
                        if isinstance(resource, str) and 'raw.githubusercontent.com/argoproj/argo-cd/' in resource:
                            version = re.search(r'/argo-cd/(v[0-9.]+)/', resource)
                            if version:
                                add('Argo CD upstream bundle', version[1], 'release URL; transitive images upstream', path)
            if document.get('kind') == 'ConfigMap' and document.get('metadata', {}).get('name') == 'minecraft-config':
                data = document['data']
                for key in ('VERSION', 'FABRIC_LOADER_VERSION', 'FABRIC_LAUNCHER_VERSION'):
                    add('Minecraft: ' + key, data[key], 'version', path)
                for line in data['MODRINTH_PROJECTS'].splitlines():
                    project, version_id = line.split(':', 1)
                    add('Minecraft mod: ' + project, version_id, 'Modrinth version ID', path)
    path = root / 'mise.toml'
    for name, version in tomllib.loads(path.read_text())['tools'].items():
        add('Development tool: ' + name, version, 'version; not host installation', path)
    for path in sorted(path for path in sources if path.parent == root / '.github/workflows'):
        for document in yaml.safe_load_all(path.read_text()):
            for mapping in walk(document):
                if isinstance(mapping.get('uses'), str):
                    reference = mapping['uses']
                    add('GitHub Action', reference, 'commit SHA' if re.search(r'@[0-9a-f]{40}$', reference) else 'tag only', path)
    path = root / 'scripts/requirements-monitoring.txt'
    for requirement in path.read_text().splitlines():
        if requirement and not requirement.startswith('#'):
            add('Validation Python package', requirement, 'version', path)
    for path in sorted(path for path in sources if path.name == '.terraform.lock.hcl'):
        for provider, version in re.findall(r'provider "([^"]+)" \{\s*version\s*=\s*"([^"]+)"', path.read_text()):
            add('OpenTofu provider: ' + provider, version, 'lockfile version and checksums', path)
    path = root / 'docs/minecraft.md'
    match = re.search(r'Fabulously Optimized client pack `([^`]+)`', path.read_text())
    if match:
        add('Minecraft client pack', match[1], 'documented client contract', path)
    return sorted(rows)


def render(root):
    lines = ['# Recorded component versions', '',
        'Generated by `scripts/maintenance-inventory`; do not edit this table manually.',
        'This is repository intent, not a latest-version, vulnerability, registry-digest',
        'verification or live-installation report. It performs no network requests.', '',
        '| Component | Recorded reference | Pin scope | Source |',
        '| --- | --- | --- | --- |']
    for component, reference, pin, source in collect(root):
        clean = lambda value: value.replace('|', '&#124;').replace('\n', ' ').replace('`', '')
        lines.append('| ' + ' | '.join([clean(component), '`' + clean(reference) + '`', clean(pin),
                                      '[' + clean(source) + '](../' + source + ')']) + ' |')
    lines += ['', 'Operator-managed proxy/transitive images follow their pinned upstream chart/bundle;',
              'their actual deployed digests require separate live inspection. Host K3s/Restic,',
              'OS packages, host Tailscale/Sunshine and private configuration are not managed by',
              '`mise.toml` or inferred from this table. See [maintenance](maintenance.md).', '']
    return '\n'.join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--check', action='store_true', help='Fail if the committed generated table is stale')
    mode.add_argument('--write', action='store_true', help='Regenerate only docs/versions.md for review')
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    text = render(root)
    output = root / 'docs/versions.md'
    if args.check:
        if not output.exists() or output.read_text() != text:
            print('FAIL: regenerate docs/versions.md with scripts/maintenance-inventory --write', file=sys.stderr)
            return 1
        print('PASS: recorded version inventory matches source definitions')
    elif args.write:
        output.write_text(text)
    else:
        print(text, end='')
    return 0


if __name__ == '__main__':
    sys.exit(main())
