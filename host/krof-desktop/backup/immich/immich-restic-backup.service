[Unit]
Description=Immich Restic backup
RequiresMountsFor=/mnt/data-drive-2tb /mnt/backup
ConditionPathIsMountPoint=/mnt/data-drive-2tb
ConditionPathIsMountPoint=/mnt/backup
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077

ExecStart=/usr/local/sbin/immich-restic-backup

CacheDirectory=restic-immich
CacheDirectoryMode=0700
Environment=RESTIC_CACHE_DIR=/var/cache/restic-immich

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

ReadOnlyPaths=/mnt/data-drive-2tb/homelab/immich
ReadWritePaths=/mnt/backup/homelab/immich/repository

TimeoutStartSec=12h