#!/usr/bin/env bash
# Explicit operator installation; never initialize/replace credentials or storage.
set -euo pipefail
[[ ${EUID} -eq 0 ]] || { echo 'Interactive sudo is required' >&2; exit 1; }
[[ $(hostname -s) == krof-desktop ]] || { echo 'Wrong host' >&2; exit 1; }
source_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
for destination in /usr/local/sbin/minecraft-restic-backup /etc/systemd/system/minecraft-restic-backup.service /etc/systemd/system/minecraft-restic-backup.timer; do
  [[ ! -e ${destination} && ! -L ${destination} ]] || { echo 'Existing installation detected; preserve/review before updating' >&2; exit 1; }
done
[[ $(systemctl show minecraft-restic-backup.service -p LoadState --value) == not-found ]] || { echo 'Existing systemd unit detected' >&2; exit 1; }
python3 "${source_directory}/check-minecraft-backup"
bash -n "${source_directory}/minecraft-restic-backup"
install -o root -g root -m 0750 "${source_directory}/minecraft-restic-backup" /usr/local/sbin/minecraft-restic-backup
install -o root -g root -m 0644 "${source_directory}/minecraft-restic-backup.service" /etc/systemd/system/minecraft-restic-backup.service
install -o root -g root -m 0644 "${source_directory}/minecraft-restic-backup.timer" /etc/systemd/system/minecraft-restic-backup.timer
systemd-analyze verify /etc/systemd/system/minecraft-restic-backup.service /etc/systemd/system/minecraft-restic-backup.timer
systemctl daemon-reload
echo 'Installed only Minecraft backup files. Timer remains disabled; no backup was started.'
echo 'Next: run the service manually, verify recovery/password custody, then explicitly enable the timer.'
