[Unit]
Description=Minecraft Restic backup
RequiresMountsFor=/mnt/data-drive-2tb /mnt/backup
Wants=k3s.service
After=local-fs.target k3s.service
ConditionPathIsMountPoint=/mnt/data-drive-2tb
ConditionPathIsMountPoint=/mnt/backup

[Service]
Type=oneshot
User=root
Group=root
UMask=0077

ExecStart=/usr/local/sbin/minecraft-restic-backup

CacheDirectory=restic-minecraft
CacheDirectoryMode=0700
Environment=HOME=/var/cache/restic-minecraft
Environment=RESTIC_CACHE_DIR=/var/cache/restic-minecraft
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

ReadOnlyPaths=/mnt/data-drive-2tb/homelab/minecraft
ReadWritePaths=/mnt/backup/homelab/minecraft/repository

TimeoutStartSec=12h
