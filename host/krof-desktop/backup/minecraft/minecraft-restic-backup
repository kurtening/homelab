#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

DATA_MOUNT="/mnt/data-drive-2tb"
BACKUP_MOUNT="/mnt/backup"

DATA_UUID="cb3505ce-970c-49c2-ad50-4bc07ddbe508"
BACKUP_UUID="3180031e-abd5-4d6a-8aac-abe3e41dc950"

DATA_ROOT="${DATA_MOUNT}/homelab/minecraft"

RESTIC_REPOSITORY="${BACKUP_MOUNT}/homelab/minecraft/repository"
RESTIC_PASSWORD_FILE="/etc/restic/minecraft-password"

K3S_BIN="/usr/local/bin/k3s"
MINECRAFT_NAMESPACE="minecraft"
MINECRAFT_LABEL_SELECTOR="app.kubernetes.io/name=minecraft,app.kubernetes.io/component=server"
MINECRAFT_CONTAINER="minecraft"

MINECRAFT_POD=""
SAVES_DISABLED=0

export RESTIC_REPOSITORY
export RESTIC_PASSWORD_FILE

log() {
  printf '%s %s\n' "$(date --iso-8601=seconds)" "$*"
}

die() {
  log "ERROR: $*"
  exit 1
}

rcon() {
  "${K3S_BIN}" kubectl \
    --namespace "${MINECRAFT_NAMESPACE}" \
    exec "${MINECRAFT_POD}" \
    --container "${MINECRAFT_CONTAINER}" \
    -- \
    rcon-cli "$@"
}

cleanup() {
  local status=$?

  trap - EXIT

  if [[ "${SAVES_DISABLED}" -eq 1 ]]; then
    log "Re-enabling Minecraft world saves"
    if ! rcon save-on; then
      log "ERROR: Failed to re-enable Minecraft world saves"
      status=1
    fi
  fi

  exit "${status}"
}

trap cleanup EXIT

verify_mount() {
  local mount_path="$1"
  local expected_uuid="$2"
  local source_device
  local actual_uuid
  local filesystem

  mountpoint --quiet "${mount_path}" ||
    die "${mount_path} is not a mount point"

  source_device="$(
    findmnt --raw --noheadings --target "${mount_path}" --output SOURCE
  )"

  filesystem="$(
    findmnt --raw --noheadings --target "${mount_path}" --output FSTYPE
  )"

  actual_uuid="$(
    blkid --match-tag UUID --output value "${source_device}"
  )"

  [[ "${filesystem}" == "ext4" ]] ||
    die "${mount_path} uses ${filesystem}, expected ext4"

  [[ "${actual_uuid}" == "${expected_uuid}" ]] ||
    die "${mount_path} UUID is ${actual_uuid}, expected ${expected_uuid}"
}

log "Validating storage mounts"

verify_mount "${DATA_MOUNT}" "${DATA_UUID}"
verify_mount "${BACKUP_MOUNT}" "${BACKUP_UUID}"

[[ -d "${DATA_ROOT}" ]] ||
  die "Missing source directory: ${DATA_ROOT}"

[[ -d "${RESTIC_REPOSITORY}" ]] ||
  die "Missing Restic repository: ${RESTIC_REPOSITORY}"

[[ -r "${RESTIC_PASSWORD_FILE}" ]] ||
  die "Restic password file is unavailable"

[[ -x "${K3S_BIN}" ]] ||
  die "K3s binary is unavailable: ${K3S_BIN}"

command -v restic >/dev/null ||
  die "restic is unavailable"

log "Locating Minecraft pod"

pod_list="$(
  "${K3S_BIN}" kubectl \
    --namespace "${MINECRAFT_NAMESPACE}" \
    get pods \
    --selector "${MINECRAFT_LABEL_SELECTOR}" \
    --output jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'
)"

mapfile -t minecraft_pods < <(sed '/^$/d' <<<"${pod_list}")

[[ "${#minecraft_pods[@]}" -eq 1 ]] ||
  die "Expected exactly one Minecraft pod, found ${#minecraft_pods[@]}"

MINECRAFT_POD="${minecraft_pods[0]}"

log "Waiting for Minecraft pod readiness"

"${K3S_BIN}" kubectl \
  --namespace "${MINECRAFT_NAMESPACE}" \
  wait \
  --for=condition=Ready \
  "pod/${MINECRAFT_POD}" \
  --timeout=10m

log "Validating Restic repository"
restic snapshots >/dev/null

log "Flushing and suspending Minecraft world saves"
rcon save-off
SAVES_DISABLED=1
rcon save-all flush

log "Creating Minecraft snapshot"

cd "${DATA_ROOT}"

restic backup \
  --host krof-desktop \
  --tag minecraft \
  --one-file-system \
  .

log "Re-enabling Minecraft world saves"
rcon save-on
SAVES_DISABLED=0

log "Applying retention policy"

restic forget \
  --host krof-desktop \
  --tag minecraft \
  --group-by host,paths,tags \
  --keep-daily 7 \
  --keep-weekly 4 \
  --keep-monthly 6 \
  --prune

log "Checking repository structure"
restic check

log "Minecraft backup completed successfully"
