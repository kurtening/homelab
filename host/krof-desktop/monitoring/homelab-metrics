#!/usr/bin/env python3
"""Read systemd/mount metadata only; never open credentials or backup repositories."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import tempfile
import time

APPLICATIONS = ('immich', 'jellyfin', 'minecraft')
MOUNTS = {'data': ('/mnt/data-drive-2tb', 'cb3505ce-970c-49c2-ad50-4bc07ddbe508'),
          'backup': ('/mnt/backup', '3180031e-abd5-4d6a-8aac-abe3e41dc950')}


def command(args):
    return subprocess.run(args, capture_output=True, text=True, timeout=8, check=True).stdout


def usec(unit, prop):
    name = unit.replace('-', '_2d').replace('.', '_2e')
    value = command(['busctl', 'get-property', 'org.freedesktop.systemd1',
                     '/org/freedesktop/systemd1/unit/' + name,
                     'org.freedesktop.systemd1.Service', prop]).split()
    if len(value) != 2 or value[0] != 't':
        raise ValueError('Invalid timestamp')
    return int(value[1]) / 1e6


def observation(app):
    unit = app + '-restic-backup.service'
    fields = dict(line.split('=', 1) for line in command(['systemctl', 'show', unit,
                  '-p', 'LoadState', '-p', 'ActiveState', '-p', 'Result', '-p', 'ExecMainStatus']).splitlines())
    if fields.get('LoadState') != 'loaded':
        return {'available': False, 'running': False, 'start': 0, 'finish': 0, 'success': False}
    return {'available': True, 'running': fields['ActiveState'] in ('active', 'activating'),
            'start': usec(unit, 'ExecMainStartTimestamp'), 'finish': usec(unit, 'ExecMainExitTimestamp'),
            'success': fields['Result'] == 'success' and fields['ExecMainStatus'] == '0'}


def update(previous, observed, now):
    # A running attempt can still expose the previous invocation's exit result.
    state = dict(previous)
    for key in ('last_success', 'last_failure', 'last_run'):
        state[key] = float(state.get(key, 0))
        if not 0 <= state[key] <= now + 60:
            raise ValueError('Invalid stored timestamp')
    if observed['available']:
        state['last_run'] = max(state['last_run'], observed['start'])
        if not observed['running'] and 0 < observed['finish'] <= now + 60:
            key = 'last_success' if observed['success'] else 'last_failure'
            state[key] = max(state[key], observed['finish'])
    return state


def mount_valid(path, expected_uuid):
    try:
        values = json.loads(command(['findmnt', '--json', '--mountpoint', path, '--output', 'TARGET,FSTYPE,UUID']))['filesystems']
    except subprocess.CalledProcessError:
        return False
    return len(values) == 1 and values[0] == {'target': path, 'fstype': 'ext4', 'uuid': expected_uuid}


def collect(previous, now):
    state, lines = {}, []
    def gauge(name, value, labels=''):
        lines.append(name + labels + ' ' + str(float(value)))
    for app in APPLICATIONS:
        observed = observation(app)
        state[app] = update(previous.get(app, {}), observed, now)
        labels = '{application="' + app + '"}'
        for key in ('last_success', 'last_failure', 'last_run'):
            gauge('homelab_backup_' + key + '_timestamp_seconds', state[app][key], labels)
        gauge('homelab_backup_success_known', state[app]['last_success'] > 0, labels)
        gauge('homelab_backup_service_available', observed['available'], labels)
        gauge('homelab_backup_service_running', observed['running'], labels)
        gauge('homelab_backup_service_failed', observed['available'] and not observed['running'] and not observed['success'], labels)
    for role, (path, expected_uuid) in MOUNTS.items():
        gauge('homelab_storage_mount_valid', mount_valid(path, expected_uuid), '{role="' + role + '"}')
    gauge('homelab_collector_last_success_timestamp_seconds', now)
    return state, '\n'.join(lines) + '\n'


def atomic_write(path, content, mode):
    descriptor, temporary = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w') as output:
            os.fchmod(output.fileno(), mode)
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--state-dir', type=Path, default=Path('/var/lib/homelab-monitoring'))
    parser.add_argument('--check', action='store_true', help='Read-only preview; do not create/update state')
    args = parser.parse_args()
    path = args.state_dir / 'state.json'
    previous = {}
    if path.exists():
        if path.stat().st_size > 65536:
            raise ValueError('Oversized state')
        previous = json.loads(path.read_text())
    state, metrics = collect(previous, time.time())
    if args.check:
        print(metrics, end='')
        return
    args.state_dir.mkdir(mode=0o755, parents=True, exist_ok=True)
    textfile = args.state_dir / 'textfile'
    textfile.mkdir(mode=0o755, exist_ok=True)
    # The service's UMask=0077 must not make numeric metrics unreadable to the
    # unprivileged Node Exporter bind mount. State JSON remains private.
    textfile.chmod(0o755)
    atomic_write(path, json.dumps(state), 0o600)
    atomic_write(textfile / 'homelab.prom', metrics, 0o644)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        raise SystemExit('Collector failed; prior state/metrics retained where possible; inspect locally')
