#!/usr/bin/env python3
"""Read-only root preflight for the exporter's bind view and Alloy journal access."""
import hashlib
import os
from pathlib import Path
import stat
import subprocess
import time

METRICS = Path('/var/lib/homelab-monitoring/textfile')
EXPECTED_COLLECTOR = '4993ddcca0479abbe2f2d3a2cbc78f4781689b8fc58649c7f07c2d71c5edddad'


def exporter_check(directory_fd):
    os.setgroups([])
    os.setgid(65534)
    os.setuid(65534)
    descriptor = os.open('homelab.prom', os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory_fd)
    with os.fdopen(descriptor, 'r') as source:
        data = source.read(65537)
    if len(data) > 65536:
        raise ValueError('Unexpected textfile size')
    lines = [line.split() for line in data.splitlines()]
    if not lines or any(len(line) != 2 or not line[0].startswith('homelab_') for line in lines):
        raise ValueError('Unexpected metric format')
    values = {name: float(value) for name, value in lines}
    age = time.time() - values['homelab_collector_last_success_timestamp_seconds']
    if not -60 <= age <= 180:
        raise ValueError('Stale collector output')
    for role in ['data', 'backup']:
        if values['homelab_storage_mount_valid{role="' + role + '"}'] != 1:
            raise ValueError('Expected mount identity is not valid')


def journal_check(files):
    os.setgroups([101])
    os.setgid(473)
    os.setuid(473)
    # Read only a file header, not records or application contents.
    if not any(readable_header(path) for path in files):
        raise ValueError('No journal file readable with Alloy UID/group')


def readable_header(path):
    try:
        with open(path, 'rb') as source:
            return source.read(8) == b'LPKSHHRH'
    except OSError:
        return False


def child_check(check):
    pid = os.fork()
    if pid == 0:
        try:
            check()
        except (OSError, ValueError, KeyError):
            os._exit(1)
        os._exit(0)
    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status) == 0


def main():
    if os.geteuid() != 0:
        print('PENDING: interactive sudo required; this checker never changes files, permissions or services')
        return 2
    if hashlib.sha256(Path('/usr/local/sbin/homelab-metrics').read_bytes()).hexdigest() != EXPECTED_COLLECTOR:
        raise ValueError('Unexpected installed collector version')
    result = subprocess.run(['systemctl', 'show', 'homelab-metrics.service', '-p', 'Result', '-p', 'ExecMainStatus'], capture_output=True, text=True, check=True)
    fields = dict(line.split('=', 1) for line in result.stdout.splitlines())
    if fields != {'Result': 'success', 'ExecMainStatus': '0'}:
        raise ValueError('Collector unit is not successful')
    for action in ['is-active', 'is-enabled']:
        subprocess.run(['systemctl', action, '--quiet', 'homelab-metrics.timer'], check=True)
    if METRICS.is_symlink() or stat.S_IMODE(METRICS.stat().st_mode) != 0o755:
        raise ValueError('Unexpected numeric directory permissions')
    file = METRICS / 'homelab.prom'
    if file.is_symlink() or not stat.S_ISREG(file.stat().st_mode) or stat.S_IMODE(file.stat().st_mode) != 0o644:
        raise ValueError('Unexpected numeric file permissions')
    descriptor = os.open(METRICS, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        if not child_check(lambda: exporter_check(descriptor)):
            raise ValueError('Exporter bind-view readability/freshness failed')
    finally:
        os.close(descriptor)
    print('PASS: exporter UID can read fresh numeric metrics through the bind-directory view; both mounts valid')
    roots = [Path('/var/log/journal'), Path('/run/log/journal')]
    if not all(path.is_dir() for path in roots) or not Path('/etc/machine-id').is_file():
        raise ValueError('Journal/machine-id hostPath prerequisite missing')
    files = [str(p) for root in roots for p in root.glob('*/*.journal') if p.is_file()]
    if not child_check(lambda: journal_check(files)):
        raise ValueError('Alloy journal UID/group preflight failed')
    print('PASS: Alloy UID with verified journal group can open a journal header; no records displayed')
    print('PASS: installed collector version, successful service and enabled/active timer')
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.SubprocessError):
        raise SystemExit('FAIL: protected host prerequisite could not be verified; inspect locally, never open private parent permissions')
