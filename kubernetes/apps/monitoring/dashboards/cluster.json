{
  "uid":"homelab-cluster","title":"Kubernetes and Argo","schemaVersion":39,"version":1,
  "refresh":"1m","time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"title":"Available / desired Deployment replicas","type":"timeseries","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"sum by(namespace) (kube_deployment_status_replicas_available)","legendFormat":"{{namespace}} ready","refId":"A"},{"expr":"sum by(namespace) (kube_deployment_spec_replicas)","legendFormat":"{{namespace}} desired","refId":"B"}]},
    {"id":2,"title":"Container working sets","type":"timeseries","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"fieldConfig":{"defaults":{"unit":"bytes"}},"targets":[{"expr":"sum by(namespace,pod) (container_memory_working_set_bytes{container!=\"\",container!=\"POD\"})","legendFormat":"{{namespace}}/{{pod}}","refId":"A"}]},
    {"id":3,"title":"Argo applications (status in legend)","type":"stat","gridPos":{"x":0,"y":8,"w":24,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"argocd_app_info","legendFormat":"{{name}}: {{health_status}} / {{sync_status}}","refId":"A"}]},
    {"id":4,"title":"Monitoring working set + proxy + collector allowance (target under 1 GiB)","type":"timeseries","gridPos":{"x":0,"y":16,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"fieldConfig":{"defaults":{"unit":"bytes"}},"targets":[{"expr":"homelab:monitoring_working_set_bytes","refId":"A"}]},
    {"id":5,"title":"Firing alerts","type":"table","gridPos":{"x":12,"y":16,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"ALERTS{alertstate=\"firing\"}","instant":true,"format":"table","refId":"A"}]}
  ]
}
